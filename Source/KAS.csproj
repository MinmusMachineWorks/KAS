<Project Sdk="Microsoft.NET.Sdk">

  <!-- Built with KSPBuildTools (see ../Directory.Build.props). Upstream's old-style project
       referenced KSP through a Q:\ virtual drive and only built on Windows. -->
  <PropertyGroup>
    <RootNamespace>KAS</RootNamespace>
    <AssemblyName>KAS</AssemblyName>
    <LangVersion>9</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- AssemblyInfo.cs uses AssemblyVersion("1.12.*"), which needs a non-deterministic build. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prebuilt, shipped from Binaries/ as upstream does; not copied by the build. -->
    <Reference Include="KAS-API-v2">
      <HintPath>../Binaries/KAS-API-v2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KSPDev_Utils.2.7">
      <HintPath>../Binaries/KSPDev_Utils.2.7.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
